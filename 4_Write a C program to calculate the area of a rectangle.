#include <stdio.h>

int main()
{
    int l, b, area;

    printf("Area of Rectangle\n");

    printf("Enter the length: ");
    scanf("%d", &l);

    printf("Enter the breadth: ");
    scanf("%d", &b);

    area = l * b;

    printf("Area of Rectangle is: %d", area);

    return 0;
}



// output: Area of Rectangle

// Enter the length: 5
// Enter the breadth: 4

// Area of Rectangle is: 20
